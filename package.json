{
  "name": "spillway-guard",
  "version": "0.6.0",
  "description": "Spillway page-entry queue guard for Cloudflare Workers sites",
  "type": "module",
  "main": "./dist/spillway-guard.js",
  "types": "./dist/spillway-guard.d.ts",
  "exports": {
    ".": {
      "types": "./dist/spillway-guard.d.ts",
      "import": "./dist/spillway-guard.js",
      "default": "./dist/spillway-guard.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandarasoft/spillway-guard.git"
  },
  "keywords": [
    "cloudflare-workers",
    "waiting-room",
    "queue",
    "spillway"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example:dev": "wrangler dev examples/site-worker.ts --config examples/wrangler.example.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
